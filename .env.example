# ==============================================================================
# FLOWGUARD AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowguard
DB_USER=flowguard
DB_PASSWORD=flowguard_secret

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# JWT Security
JWT_SECRET=4c9a632e8f1b4021a8d052d9b671f30c5e7b2a9d8c3e4f1a2b5d6e7f8a9b0c1d
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Local Open-Source AI (Ollama - Free & Offline)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30

# Optional Cloud AI (OpenAI API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
SSRF_PROTECTION_ENABLED=true

